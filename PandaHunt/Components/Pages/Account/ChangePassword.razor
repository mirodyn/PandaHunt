@page "/ucet/heslo"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Změna hesla · PandaHunt IV</PageTitle>

@* Static page on purpose: after the change the login cookie has to be renewed (SignInManager.RefreshSignInAsync),
   which needs a normal request, not the interactive circuit. *@
<PageShell Title="Změna hesla" BackHref="/ucet" BackText="Zpět na můj účet">
    <EditForm Model="Input" FormName="zmena-hesla" OnValidSubmit="ChangeAsync" method="post" class="ph-form">
        <DataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <ul class="ph-form-errors" role="alert">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="ph-field">
            <label for="current">Současné heslo</label>
            <InputText id="current" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" class="ph-input" />
            <ValidationMessage For="() => Input.CurrentPassword" />
        </div>
        <div class="ph-field">
            <label for="new">Nové heslo</label>
            <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" class="ph-input" />
            <ValidationMessage For="() => Input.NewPassword" />
        </div>
        <div class="ph-field">
            <label for="new2">Nové heslo znovu</label>
            <InputText id="new2" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" class="ph-input" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true">
            Změnit heslo
        </MudButton>
    </EditForm>
</PageShell>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private readonly List<string> errors = [];

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AccountEndpoints.LoginPath);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            errors.AddRange(result.Errors.Select(e => e.Code == nameof(IdentityErrorDescriber.PasswordMismatch)
                ? "Současné heslo nesedí."
                : e.Description));
            return;
        }

        // Changing the password renews the security stamp, which would log this browser out within a minute.
        await SignInManager.RefreshSignInAsync(user);
        Navigation.NavigateTo("/ucet?heslo=zmeneno");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vyplň současné heslo.")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Vyplň nové heslo.")]
        [MinLength(AccountRules.MinPasswordLength, ErrorMessage = "Heslo musí mít aspoň 6 znaků.")]
        public string NewPassword { get; set; } = "";

        [Compare(nameof(NewPassword), ErrorMessage = "Hesla se neshodují.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
