@page "/lov"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@inject GameSchedule Schedule
@inject GameSettingsStore Settings
@inject HuntTasks Tasks
@inject Scoreboard Scoreboard
@inject BonusEvents Events

<PageTitle>Lov · PandaHunt IV</PageTitle>

@if (!CanSeeHub)
{
    <PageShell Title="Lov">
        <p>Lov ještě nezačal.</p>
        <p>
            @if (Schedule.HuntStartsAt is { } start)
            {
                @($"Začíná {Schedule.Format(start)}.")
            }
            else
            {
                @("Termín bude brzy oznámen.")
            }
        </p>
    </PageShell>
}
else
{
    <PageShell Title="Lov" Wide="true">
        @if (Banner is { } banner)
        {
            <p class="ph-banner">@banner</p>
        }

        <div class="ph-hunt">
            @* DOM order = phone order (intro, buttons, tasks, points); on wider screens the grid in
               Hunt.razor.css puts intro, points and buttons in the right-hand column. *@
            <div class="ph-hunt-intro">
                @foreach (var paragraph in IntroParagraphs)
                {
                    <p>@paragraph</p>
                }
            </div>

            <nav class="ph-hunt-buttons" aria-label="Další stránky">
                <MudButton Href="/zebricek" Variant="Variant.Outlined" Color="Color.Primary">Žebříček</MudButton>
                @* TODO: Href="/pravidla" once the rules page exists. *@
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="true" title="Pravidla budou brzy">Pravidla</MudButton>
            </nav>

            <div class="ph-hunt-main">
                @* Bonus event: the running one, else the next planned one, else "none right now". *@
                @if (events is not null)
                {
                    var bonus = BonusEvents.CurrentOf(events, Schedule.Now);
                    if (bonus is null)
                    {
                        <div class="ph-bonus ph-bonus-none">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="ph-bonus-icon" />
                            <div class="ph-bonus-text">
                                <div class="ph-bonus-kicker">Bonusová akce</div>
                                <div class="ph-display ph-bonus-name">Teď žádná neprobíhá</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        var live = bonus.StateAt(Schedule.Now) == BonusEventState.Live;
                        var claimed = claimedEvents.Contains(bonus.Id);
                        <a class="ph-bonus @(live ? "ph-bonus-live" : "ph-bonus-planned")" href="@BonusEvents.PageOf(bonus.Id)">
                            <MudIcon Icon="@(claimed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.LocationOn)"
                                     Title="@(claimed ? "Body máš" : "Bonusová akce")"
                                     Class="ph-bonus-icon" />
                            <div class="ph-bonus-text">
                                <div class="ph-bonus-kicker">
                                    @if (live)
                                    {
                                        <span class="ph-bonus-dot" aria-hidden="true"></span>
                                    }
                                    @(live ? "Probíhá bonusová akce" : "Chystá se bonusová akce")
                                </div>
                                <div class="ph-display ph-bonus-name">@bonus.Name</div>
                                <div class="ph-bonus-when">
                                    @(live ? $"Končí {Schedule.Format(bonus.EndsAt)}" : Schedule.FormatRange(bonus.StartsAt, bonus.EndsAt))
                                </div>
                            </div>
                            <div class="ph-bonus-side">
                                @if (claimed)
                                {
                                    <span class="ph-bonus-claimed">Body máš</span>
                                }
                                else
                                {
                                    <PointsBadge Value="bonus.Points" Signed="true" Class="ph-display" />
                                }
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="ph-bonus-go" />
                            </div>
                        </a>
                    }
                }

                <section class="ph-hunt-tasks" aria-labelledby="ph-tasks-heading">
                    <h2 id="ph-tasks-heading" class="ph-display">Úkoly</h2>
                    @if (tasks is null)
                    {
                        <p>Načítám…</p>
                    }
                    else if (tasks.Count == 0)
                    {
                        <p>Úkoly se brzy objeví.</p>
                    }
                    else
                    {
                        <ul class="ph-tasks">
                            @foreach (var task in tasks)
                            {
                                var state = StateOf(task);
                                var type = TaskTypes.Get(task.Type);
                                var link = OpenLink(task, state);
                                var external = link is not null && TaskPages.IsExternal(link);
                                <li>
                                    @* An <a> without href (task not open yet / no page) is just a plain, unclickable tile. *@
                                    <a class="ph-task @StateClass(state)"
                                       href="@link"
                                       target="@(external ? "_blank" : null)"
                                       rel="@(external ? "noopener" : null)">
                                        <div class="ph-task-icons">
                                            <MudIcon Icon="@type.Icon" Title="@type.Label" Class="ph-task-type" />
                                            <MudIcon Icon="@(state == TaskState.Done ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                     Title="@(state == TaskState.Done ? "Splněno" : "Nesplněno")"
                                                     Class="ph-task-state" />
                                        </div>
                                        <div class="ph-display ph-task-name">@task.Name</div>
                                        <div class="ph-task-status">
                                            <span>@StatusText(task, state)</span>
                                            @if (link is not null)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="ph-task-go" />
                                            }
                                        </div>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <section class="ph-points" aria-labelledby="ph-points-heading">
                <h2 id="ph-points-heading" class="ph-display">Tvoje body</h2>
                <div class="ph-points-total">
                    <PointsBadge Value="Total" Class="ph-display" />
                </div>
                @if (rank is not null)
                {
                    <div class="ph-points-rank">@rank. místo v žebříčku</div>
                }

                @if (history is { Count: > 0 })
                {
                    <PointsHistory Entries="history" />
                }
                else if (history is not null)
                {
                    <p class="ph-points-empty">Zatím žádné body. První přijdou se splněným úkolem.</p>
                }
            </section>
        </div>
    </PageShell>
}

@code {
    private enum TaskState { Planned, Open, Done }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string playerId = "";
    private bool isAdmin;
    private IReadOnlyList<HuntTaskView>? tasks;
    private IReadOnlySet<int> completed = new HashSet<int>();
    private IReadOnlyList<PointEntryView>? history;
    private IReadOnlyList<BonusEventView>? events;
    private IReadOnlySet<int> claimedEvents = new HashSet<int>();
    private int? rank;
    private Timer? clock;

    // Players see the hub while the hunt runs and after it ends; admins can preview it any time.
    private bool CanSeeHub => Schedule.IsHuntOpen || Schedule.IsHuntOver || isAdmin;

    private string? Banner => Schedule switch
    {
        { IsHuntOpen: true } => null,
        { IsHuntOver: true } => "Lov skončil. Díky všem, kdo se zúčastnili!",
        { HuntStartsAt: { } start } => $"Náhled pro admina – hráči tuhle stránku uvidí od {Schedule.Format(start)}.",
        _ => "Náhled pro admina – hráči tuhle stránku uvidí, až nastavíš začátek lovu.",
    };

    private int Total => history?.Sum(e => e.Points) ?? 0;

    private IEnumerable<string> IntroParagraphs =>
        (string.IsNullOrWhiteSpace(Settings.Current.HuntIntro) ? GameSettings.SampleHuntIntro : Settings.Current.HuntIntro)
            .ReplaceLineEndings("\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        playerId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        isAdmin = user.IsInRole(AppRoles.Admin);

        Tasks.Changed += OnDataChanged;
        Scoreboard.Changed += OnDataChanged;
        Events.Changed += OnDataChanged;
        Settings.Changed += OnSettingsChanged;
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Tasks open and bonus events start/end at set times: re-check every 30 s, no page reload needed.
        if (firstRender)
            clock = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync()
    {
        tasks = await Tasks.GetAllAsync();
        completed = await Tasks.GetCompletedTaskIdsAsync(playerId);
        history = await Scoreboard.GetPlayerHistoryAsync(playerId);
        rank = (await Scoreboard.GetStandingsAsync()).FirstOrDefault(s => s.PlayerId == playerId)?.Rank;
        events = await Events.GetAllAsync();
        claimedEvents = await Events.GetClaimedEventIdsAsync(playerId);
    }

    private TaskState StateOf(HuntTaskView task) =>
        completed.Contains(task.Id) ? TaskState.Done
        : task.OpensAt is { } opens && Schedule.Now >= opens ? TaskState.Open
        : TaskState.Planned;

    // Open and finished tasks lead to their page; admins can also open planned ones to preview them.
    private string? OpenLink(HuntTaskView task, TaskState state) =>
        task.Link is not null && (state != TaskState.Planned || isAdmin) ? task.Link : null;

    private static string StateClass(TaskState state) => state switch
    {
        TaskState.Done => "ph-task-done",
        TaskState.Open => "ph-task-open",
        _ => "ph-task-planned",
    };

    private string StatusText(HuntTaskView task, TaskState state) => state switch
    {
        TaskState.Done => "Splněno",
        TaskState.Open => "Nesplněno",
        _ when task.OpensAt is { } opens => $"Od {Schedule.FormatDate(opens)}",
        _ => "Připravujeme",
    };

    // Tasks, completions, points or bonus events changed (for anyone): reload this player's view.
    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // Circuit went away while reloading.
        }
    });

    // Intro text or hunt dates changed.
    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Tasks.Changed -= OnDataChanged;
        Scoreboard.Changed -= OnDataChanged;
        Events.Changed -= OnDataChanged;
        Settings.Changed -= OnSettingsChanged;
        clock?.Dispose();
    }
}
