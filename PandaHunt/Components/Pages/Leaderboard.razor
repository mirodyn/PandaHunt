@page "/zebricek"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@inject Scoreboard Scoreboard
@inject Teams Teams
@inject GameSchedule Schedule
@inject GameSettingsStore Settings
@inject IDialogService Dialogs

<PageTitle>Žebříček · PandaHunt IV</PageTitle>

@* A bit wider than the usual card: five columns. *@
<PageShell Title="Žebříček" CardClass="ph-card-medium">
    <p>@Note</p>
    @if (standings is { Count: > 0 })
    {
        <p class="ph-rank-hint">Klikni na lovce a uvidíš, za co má body.</p>
        <p class="ph-rank-hint">
            Pořadí určuje celkový součet: body plus hvězdy
            (<span class="ph-rank-legend"><StarIcon Color="StarColor.Gold" /> 3</span>,
            <span class="ph-rank-legend"><StarIcon Color="StarColor.Silver" /> 2</span>,
            <span class="ph-rank-legend"><StarIcon Color="StarColor.Bronze" /> 1</span>).
            Hvězdu ale může přebrat jiný lovec.
        </p>
    }

    @if (standings is null)
    {
        <p class="ph-rank-empty">Načítám…</p>
    }
    else if (standings.Count == 0)
    {
        <p class="ph-rank-empty">Zatím tu nejsou žádní lovci.</p>
    }
    else
    {
        <table class="ph-ranking">
            <thead>
                <tr>
                    <th scope="col"><span class="ph-rank-th-long">Pořadí</span><span class="ph-rank-th-short" aria-hidden="true">#</span></th>
                    <th scope="col">Lovec</th>
                    <th scope="col" class="ph-rank-th-right">Body</th>
                    <th scope="col">Hvězdy</th>
                    <th scope="col" class="ph-rank-th-right">Celkem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in standings)
                {
                    var isMe = row.PlayerId == currentUserId;
                    <tr class="@RowClass(row, isMe)" aria-current="@(isMe ? "true" : null)" @onclick="() => ShowPlayerAsync(row, isMe)">
                        <td class="ph-display ph-rank-place">@row.Rank.</td>
                        <td class="ph-rank-name">
                            <button type="button" class="ph-rank-player" @onclick="() => ShowPlayerAsync(row, isMe)" @onclick:stopPropagation="true">@row.PlayerName</button>
                            @if (isMe)
                            {
                                <span class="ph-pill ph-pill-small ph-rank-me">ty</span>
                            }
                            @if (row.IsTeam)
                            {
                                <span class="ph-rank-team">tým · @string.Join(", ", row.Members!)</span>
                            }
                        </td>
                        <td class="ph-display ph-rank-points"><PointsBadge Value="row.Points" /></td>
                        <td class="ph-rank-stars"><StarTally Counts="row.Stars" ShowZero="true" /></td>
                        <td class="ph-display ph-rank-total">(<PointsBadge Value="row.Total" />)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</PageShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<Standing>? standings;
    private string? currentUserId;

    private string Note => Schedule switch
    {
        { IsHuntOver: true } => "Lov skončil. Tohle je konečné pořadí.",
        { IsHuntOpen: true } => "Body se počítají průběžně, žebříček se aktualizuje sám.",
        _ => "Body se začnou sbírat, až začne lov.",
    };

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await Teams.GetPlayerIdAsync((await AuthenticationState).User);
        Scoreboard.Changed += OnScoreboardChanged;
        Settings.Changed += OnSettingsChanged;
        standings = await Scoreboard.GetStandingsAsync();
    }

    // Anyone can open anyone's point log.
    private async Task ShowPlayerAsync(Standing row, bool isMe)
    {
        var parameters = new DialogParameters<PlayerPointsDialog>
        {
            { d => d.Player, row },
            { d => d.IsMe, isMe },
        };
        await Dialogs.ShowAsync<PlayerPointsDialog>(row.PlayerName, parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = true,
        });
    }

    private static string RowClass(Standing row, bool isMe) =>
        $"{(row.Rank == 1 ? "ph-rank-first" : "")} {(isMe ? "ph-rank-mine" : "")}".Trim();

    private void OnScoreboardChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            standings = await Scoreboard.GetStandingsAsync();
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // Circuit went away while reloading.
        }
    });

    // The hunt dates changed: refresh the note.
    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Scoreboard.Changed -= OnScoreboardChanged;
        Settings.Changed -= OnSettingsChanged;
    }
}
