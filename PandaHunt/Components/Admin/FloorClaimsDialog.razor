@* Who found a "Body na zemi" code, and when. *@
@inject FloorCodes Codes
@inject GameSchedule Schedule

<MudDialog>
    <DialogContent>
        @if (claims is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (claims.Count == 0)
        {
            <MudText>Zatím nikdo.</MudText>
        }
        else
        {
            <MudTable T="FloorClaimView" Items="claims" Dense="true" Elevation="0" Breakpoint="Breakpoint.Xs" Class="ph-admin-table">
                <HeaderContent>
                    <MudTh>Hráč</MudTh>
                    <MudTh>Kdy</MudTh>
                    <MudTh>Body</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Hráč"><strong>@context.PlayerName</strong></MudTd>
                    <MudTd DataLabel="Kdy">@Schedule.Format(context.ClaimedAtUtc)</MudTd>
                    <MudTd DataLabel="Body">@CzechText.SignedPoints(context.Points)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Dialog.Close()">Zavřít</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public int CodeId { get; set; }

    private IReadOnlyList<FloorClaimView>? claims;

    protected override async Task OnInitializedAsync() => claims = await Codes.GetClaimsAsync(CodeId);
}
