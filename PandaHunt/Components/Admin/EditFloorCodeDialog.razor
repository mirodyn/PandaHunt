@* Create one or more "Body na zemi" codes, or edit one (its QR stays the same). *@
@inject FloorCodes Codes

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">@* room for the first field's floating label *@
            <MudTextField T="string"
                          @bind-Value="name"
                          Label="Název"
                          Placeholder="např. Lavička u kostela"
                          Variant="Variant.Outlined"
                          MaxLength="FloorCode.MaxNameLength"
                          HelperText="Jen pro tebe – hráči ho neuvidí. Hodí se napsat, kde kód visí." />
            <MudNumericField T="int"
                             @bind-Value="points"
                             Label="Body"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="GameSettings.MaxBonusPoints" />
            @if (EditedCode is null)
            {
                <MudNumericField T="int"
                                 @bind-Value="count"
                                 Label="Kolik kódů"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="FloorCodes.MaxBatch"
                                 HelperText="Víc kódů najednou se očísluje: „Název 1“, „Název 2“… Každý má vlastní QR." />
            }
            <MudSwitch T="bool" @bind-Value="isActive" Color="Color.Primary"
                       Label="@(isActive ? "Zapnutý – hráči za něj dostanou body" : "Vypnutý – naskenování nic nedá")" />
            @if (errors.Count > 0)
            {
                <ul class="ph-form-errors" role="alert">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
            @if (EditedCode is { ClaimCount: > 0 } edited)
            {
                <MudText Typo="Typo.body2">Kód už našlo @edited.ClaimCount. Změna bodů se jich netýká – co dostali, zůstane.</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="saving">Zrušit</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="saving">Uložit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The code to edit, or null to create new ones.</summary>
    [Parameter]
    public FloorCodeView? EditedCode { get; set; }

    private string name = "";
    private int points = 1;
    private int count = 1;
    private bool isActive = true;
    private IReadOnlyList<string> errors = [];
    private bool saving;

    protected override void OnInitialized()
    {
        if (EditedCode is { } code)
        {
            name = code.Name;
            points = code.Points;
            isActive = code.IsActive;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            errors = EditedCode is { } code
                ? await Codes.UpdateAsync(new FloorCodeEdit(code.Id, name, points, isActive))
                : await Codes.CreateAsync(name, points, isActive, count);
            if (errors.Count == 0)
            {
                Dialog.Close(DialogResult.Ok(
                    EditedCode is not null ? "Kód upraven."
                    : count == 1 ? "Kód přidán."
                    : $"Přidáno {count} {CzechText.Plural(count, "kód", "kódy", "kódů")}."));
            }
        }
        finally
        {
            saving = false;
        }
    }
}
