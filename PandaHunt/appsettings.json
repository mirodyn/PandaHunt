{
  "ConnectionStrings": {
    // Relative paths are resolved against the working directory.
    // On Azure App Service (Windows) use e.g. "Data Source=D:\\home\\data\\pandahunt.db" so the file survives redeploys.
    "Default": "Data Source=App_Data/pandahunt.db"
  },
  // Game settings (phases, code, dates) live in the database and are edited on /admin.
  "TimeZone": "Europe/Prague",
  "Admin": {
    // Accounts with these e-mails are always admins. DO NOT put e-mails here - this repo is public.
    // Locally: dotnet user-secrets set "Admin:Emails:0" "you@example.com"
    // On the host: app setting / env variable "Admin__Emails__0".
    "Emails": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
